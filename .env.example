# Base URL backend Attendance API (tanpa trailing slash).
# Production (Vercel): set di dashboard Project Settings -> Environment Variables.
#   Production (VPS live): https://absensi-api.duckdns.org/attendance_api
VITE_API_BASE_URL=http://localhost:3001/attendance_api

# Fallback tunnel (ngrok) untuk API — kalau diisi, request yang gagal karena
# network error (mis. server localhost tak terjangkau) otomatis di-retry sekali
# lewat URL ini. Kosongkan kalau tidak pakai tunnel.
#   VITE_API_BASE_URL_FALLBACK=https://<random>.ngrok-free.dev/attendance_api
VITE_API_BASE_URL_FALLBACK=

# Nama cookie untuk menyimpan access & refresh token.
VITE_TOKEN_KEY=ratapansolo
VITE_REFRESH_TOKEN_KEY=ratapansolo-refresh
